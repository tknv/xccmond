          "instant": true,
          "legendFormat": "{{target_ip}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "AP Status List",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "P123456789"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "align": "auto",
        "autoMinMax": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P123456789"
          },
          "expr": "ap_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P123456789"
          },
          "expr": "ap_status",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "rgba(245, 54, 54, 0.9)",
                "value": null
              },
              {
                "color": "rgba(50, 172, 45, 0.97)",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "icon": "circle",
                        "text": "Down"
                      },
                      "1": {
                        "color": "green",
                        "icon": "circle",
                        "text": "InService"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "icon"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hostname"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Hostname"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "serialNumber"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Serial Number"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ipAddress"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "AP IP Address"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target_ip"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Controller (IP_Address)"
              },
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Go to Controller",
                    "url": "https://${__value.raw}:5825"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "field": "serialNumber"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "Value #B": 0,
              "hostname": 1,
              "serialNumber": 2,
              "ipAddress": 3,
              "target_ip": 4
            },
            "renameByName": {}
          }
        }
      ]
    }
  ],
